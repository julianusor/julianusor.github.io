---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Julián Úsuga Ortiz',
  description = 'Personal website and blog about data science, statistics, and software development',
  image = '/profile.jpg'
} = Astro.props;

const fullTitle = title === 'Julián Úsuga Ortiz' ? title : `${title} - Julián Úsuga Ortiz`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:site" content="@julianusor" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors antialiased">
    <!-- Aurora backdrop: blurred color blobs that backdrop-blur layers can pick up -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-40 -left-40 w-[40rem] h-[40rem] rounded-full bg-rose-300/40 dark:bg-fuchsia-700/20 blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-[36rem] h-[36rem] rounded-full bg-violet-300/40 dark:bg-violet-700/20 blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-[44rem] h-[44rem] rounded-full bg-sky-300/40 dark:bg-indigo-700/20 blur-3xl"></div>
    </div>

    <Navbar />
    <main class="flex-grow container mx-auto px-4 pt-24 pb-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
