---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  author: string;
  date: Date;
  modified?: Date;
  categories?: string[];
  image?: string;
  description?: string;
}

const { title, author, date, modified, categories, image, description } = Astro.props;

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(d);
}

const formattedDate = formatDate(date);
const formattedModified = modified ? formatDate(modified) : null;
const showModified = formattedModified && formattedModified !== formattedDate;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto">
    <div class="rounded-3xl border border-white/40 dark:border-white/10 bg-white/65 dark:bg-white/5 backdrop-blur-xl shadow-xl shadow-slate-900/5 overflow-hidden">
      {image && (
        <div class="aspect-[21/9] overflow-hidden">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="p-6 md:p-10">
        <!-- Header -->
        <header class="mb-8">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-5 text-slate-900 dark:text-white">
            {title}
          </h1>

          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-600 dark:text-slate-400 mb-5">
            <span class="font-medium text-slate-700 dark:text-slate-300">{author}</span>
            <span aria-hidden="true">·</span>
            <span>
              <span class="text-slate-500 dark:text-slate-500">Posted </span>
              <time datetime={date.toISOString()}>{formattedDate}</time>
            </span>
            {showModified && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  <span class="text-slate-500 dark:text-slate-500">Updated </span>
                  <time datetime={modified!.toISOString()}>{formattedModified}</time>
                </span>
              </>
            )}
          </div>

          {categories && categories.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {categories.map(category => (
                <span class="px-2.5 py-0.5 text-xs rounded-full border border-violet-300/40 dark:border-violet-300/20 bg-violet-100/60 dark:bg-violet-400/10 text-violet-800 dark:text-violet-200 backdrop-blur-sm">
                  {category}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none
          prose-headings:font-bold prose-headings:tracking-tight
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:leading-relaxed
          prose-a:text-violet-700 dark:prose-a:text-violet-300 prose-a:no-underline hover:prose-a:underline
          prose-code:bg-slate-200/60 dark:prose-code:bg-white/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-slate-900/95 dark:prose-pre:bg-black/40 prose-pre:border prose-pre:border-white/10 prose-pre:backdrop-blur-sm
          prose-img:rounded-xl prose-img:shadow-lg
          prose-blockquote:border-l-4 prose-blockquote:border-violet-400 prose-blockquote:bg-violet-50/50 dark:prose-blockquote:bg-violet-900/10 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-blockquote:py-1
          prose-table:text-sm
          prose-th:bg-white/40 dark:prose-th:bg-white/5
        ">
          <slot />
        </div>

        <!-- Back to blog link -->
        <div class="mt-12 pt-8 border-t border-slate-200/60 dark:border-white/10">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-violet-700 dark:text-violet-300 hover:underline"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to all posts
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
