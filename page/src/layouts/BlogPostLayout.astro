---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  author: string;
  date: Date;
  modified?: Date;
  categories?: string[];
  image?: string;
  description?: string;
}

const { title, author, date, modified, categories, image, description } = Astro.props;

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(d);
}

const formattedDate = formatDate(date);
const formattedModified = modified ? formatDate(modified) : null;
const showModified = formattedModified && formattedModified !== formattedDate;
---

<BaseLayout title={title} description={description} image={image}>
  <article>
    <!-- Header -->
    <header class="border-b border-ink-200 py-16 md:py-20 dark:border-ink-800">
      <a
        href="/"
        class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-400 transition-colors hover:text-ink-900 dark:text-ink-500 dark:hover:text-white"
      >
        <span class="inline-block transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        Index
      </a>

      <h1 class="mt-8 max-w-4xl text-4xl font-semibold leading-[1.08] tracking-tightest text-ink-900 md:text-5xl dark:text-white">
        {title}
      </h1>

      {description && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">
          {description}
        </p>
      )}

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-400 dark:text-ink-500">
        <span>{author}</span>
        <span>
          Posted <time datetime={date.toISOString()}>{formattedDate}</time>
        </span>
        {showModified && (
          <span>
            Updated <time datetime={modified!.toISOString()}>{formattedModified}</time>
          </span>
        )}
        {categories && categories.length > 0 && (
          <span class="text-ink-500 dark:text-ink-400">{categories.join(' · ')}</span>
        )}
      </div>
    </header>

    {image && (
      <div class="mt-12 border border-ink-200 dark:border-ink-800">
        <img src={image} alt={title} class="w-full" />
      </div>
    )}

    <!-- Content -->
    <div class="py-14 md:py-16">
      <div class="prose prose-lg max-w-prose dark:prose-invert
        prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink-900 dark:prose-headings:text-white
        prose-h2:text-2xl prose-h2:mt-14 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-3
        prose-p:text-ink-700 dark:prose-p:text-ink-300 prose-p:leading-[1.75]
        prose-li:text-ink-700 dark:prose-li:text-ink-300
        prose-strong:text-ink-900 dark:prose-strong:text-white
        prose-a:text-accent dark:prose-a:text-accent-soft prose-a:font-normal prose-a:underline prose-a:decoration-accent/30 prose-a:underline-offset-4 hover:prose-a:decoration-accent
        prose-code:font-mono prose-code:text-[0.875em] prose-code:font-normal prose-code:bg-ink-100 dark:prose-code:bg-ink-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-none prose-code:before:content-[''] prose-code:after:content-['']
        prose-pre:rounded-none prose-pre:border prose-pre:border-ink-200 dark:prose-pre:border-ink-800 prose-pre:bg-ink-50 dark:prose-pre:bg-ink-900 prose-pre:text-ink-800 dark:prose-pre:text-ink-200
        prose-img:rounded-none prose-img:border prose-img:border-ink-200 dark:prose-img:border-ink-800
        prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:pl-5 prose-blockquote:not-italic prose-blockquote:font-normal prose-blockquote:text-ink-600 dark:prose-blockquote:text-ink-400
        prose-hr:border-ink-200 dark:prose-hr:border-ink-800
        prose-table:text-sm prose-th:font-mono prose-th:text-[11px] prose-th:uppercase prose-th:tracking-[0.12em] prose-th:text-ink-500
      ">
        <slot />
      </div>
    </div>

    <!-- Footer navigation -->
    <div class="border-t border-ink-200 py-10 dark:border-ink-800">
      <a
        href="/"
        class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-500 transition-colors hover:text-accent dark:text-ink-400 dark:hover:text-accent-soft"
      >
        <span class="inline-block transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        All posts
      </a>
    </div>
  </article>
</BaseLayout>
