---
const navLinks = [
  { text: 'Index', href: '/' },
  { text: 'About', href: '/about-me' },
  { text: 'Real Estate', href: '/real-estate' },
  { text: 'Food Prices', href: '/food-prices' },
];

const socialLinks = [
  { icon: 'github', label: 'GitHub', href: 'https://github.com/julianusor' },
  { icon: 'twitter', label: 'Twitter', href: 'https://twitter.com/julianusor' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-white/80 backdrop-blur-md dark:border-ink-800 dark:bg-ink-950/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:px-10">
    <!-- Wordmark -->
    <a href="/" class="group flex items-center gap-3">
      <span class="h-3 w-3 border border-ink-900 bg-ink-900 transition-colors group-hover:bg-accent group-hover:border-accent dark:border-ink-100 dark:bg-ink-100"></span>
      <span class="text-[15px] font-semibold tracking-tight text-ink-900 dark:text-white">
        Julián Úsuga
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center md:flex">
      <ul class="flex items-center gap-8">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'font-mono text-[11px] uppercase tracking-[0.14em] transition-colors',
                isActive(link.href)
                  ? 'text-ink-900 dark:text-white'
                  : 'text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white',
              ]}
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="ml-8 flex items-center gap-5 border-l border-ink-200 pl-8 dark:border-ink-800">
        {socialLinks.map(social => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-500 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
            aria-label={social.label}
          >
            {social.icon === 'github' && (
              <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            )}
            {social.icon === 'twitter' && (
              <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            )}
          </a>
        ))}

        <button
          id="theme-toggle"
          type="button"
          class="text-ink-500 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
          aria-label="Toggle dark mode"
        >
          <svg id="theme-toggle-dark-icon" class="hidden h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg id="theme-toggle-light-icon" class="hidden h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-5 md:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        class="text-ink-500 dark:text-ink-400"
        aria-label="Toggle dark mode"
      >
        <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
      <button
        id="mobile-menu-button"
        type="button"
        class="text-ink-700 dark:text-ink-300"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile navigation -->
  <div id="mobile-menu" class="hidden border-t border-ink-200 md:hidden dark:border-ink-800">
    <ul class="mx-auto max-w-6xl px-6">
      {navLinks.map(link => (
        <li class="border-b border-ink-100 last:border-0 dark:border-ink-900">
          <a
            href={link.href}
            class="flex items-center justify-between py-4 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-700 dark:text-ink-300"
          >
            {link.text}
            <span aria-hidden="true" class="text-ink-300 dark:text-ink-600">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const updateIcon = () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.getElementById('theme-toggle-dark-icon')?.classList.toggle('hidden', !isDark);
    document.getElementById('theme-toggle-light-icon')?.classList.toggle('hidden', isDark);
  };

  const toggleTheme = () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcon();
  };

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  const menuButton = document.getElementById('mobile-menu-button');
  menuButton?.addEventListener('click', () => {
    const menu = document.getElementById('mobile-menu');
    const open = menu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
  });

  updateIcon();
</script>
