---
// Decorative backdrop for a post's cover image: anchored right, covering part of
// the surface, and faded into the page background so it reads as texture rather
// than as a picture. Purely presentational — the consumer must be `relative
// overflow-hidden` and wrap its own content in a `relative` element.
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <img
    src={src}
    alt=""
    loading="lazy"
    decoding="async"
    class="absolute inset-y-0 right-0 h-full w-full object-cover opacity-[0.27] transition-opacity duration-500 group-hover:opacity-[0.34] sm:w-3/4 dark:opacity-[0.51] dark:group-hover:opacity-[0.62]"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-white via-white/92 to-white/30 dark:from-ink-950 dark:via-ink-950/92 dark:to-ink-950/30"
  >
  </div>
</div>
