---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<BaseLayout
  title="Julián Úsuga Ortiz"
  description="Personal website and blog about data science, statistics, and software development"
>
  <!-- Hero -->
  <section class="mb-16">
    <div class="rounded-3xl border border-white/40 dark:border-white/10 bg-white/55 dark:bg-white/5 backdrop-blur-xl shadow-xl shadow-slate-900/5 p-8 md:p-12">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="relative shrink-0">
          <div class="absolute inset-0 -m-2 rounded-full bg-gradient-to-br from-rose-400/40 via-violet-400/40 to-sky-400/40 blur-xl"></div>
          <img
            src="/profile.jpg"
            alt="Julián Úsuga Ortiz"
            class="relative w-40 h-40 md:w-48 md:h-48 rounded-full object-cover ring-1 ring-white/60 dark:ring-white/10 shadow-xl"
          />
        </div>
        <div class="text-center md:text-left">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-3 text-slate-900 dark:text-white">
            Julián Úsuga Ortiz
          </h1>
          <p class="text-base md:text-lg text-violet-700 dark:text-violet-300 font-medium mb-3">
            Data Scientist · Statistician · Developer
          </p>
          <p class="text-slate-600 dark:text-slate-300 max-w-2xl">
            Personal site and blog. I write about data science, statistical analysis,
            database systems, and software development.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Posts -->
  <section>
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Recent Posts
      </h2>
      <a href="/rss.xml" class="text-sm text-slate-500 hover:text-violet-600 dark:text-slate-400 dark:hover:text-violet-300 transition-colors">
        RSS
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group flex flex-col rounded-2xl border border-white/40 dark:border-white/10 bg-white/55 dark:bg-white/5 backdrop-blur-xl shadow-lg shadow-slate-900/5 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:bg-white/70 dark:hover:bg-white/10"
        >
          {post.data.image && (
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          )}
          <div class="flex-1 flex flex-col p-6">
            <time datetime={post.data.date.toISOString()} class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
              {formatDate(post.data.date)}
            </time>

            <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white group-hover:text-violet-600 dark:group-hover:text-violet-300 transition-colors">
              {post.data.title}
            </h3>

            {post.data.description && (
              <p class="text-sm text-slate-600 dark:text-slate-300 mb-4 line-clamp-3 flex-1">
                {post.data.description}
              </p>
            )}

            {post.data.categories && post.data.categories.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
                {post.data.categories.slice(0, 3).map((category: string) => (
                  <span class="px-2 py-0.5 text-[11px] rounded-full border border-violet-300/40 dark:border-violet-300/20 bg-violet-100/60 dark:bg-violet-400/10 text-violet-800 dark:text-violet-200 backdrop-blur-sm">
                    {category}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
