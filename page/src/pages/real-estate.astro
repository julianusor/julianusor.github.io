---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = [
  { label: 'Coverage', value: 'Major cities, Colombia' },
  { label: 'Asset', value: 'Apartments' },
  { label: 'Built with', value: 'Power BI' },
];
---

<BaseLayout
  title="Real Estate Monitor"
  description="Visualize the trend in prices of apartments in the major cities in Colombia"
>
  <section class="border-b border-ink-200 py-16 md:py-20 dark:border-ink-800">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400 dark:text-ink-500">
      Dashboard · 01
    </p>
    <h1 class="mt-6 text-4xl font-semibold leading-[1.08] tracking-tightest text-ink-900 md:text-5xl dark:text-white">
      Real Estate Monitor
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">
      Apartment price trends across the major cities in Colombia, tracked over time and broken
      down by city, size, and neighbourhood.
    </p>

    <dl class="mt-10 flex flex-wrap gap-x-14 gap-y-6">
      {meta.map(item => (
        <div>
          <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-400 dark:text-ink-500">
            {item.label}
          </dt>
          <dd class="mt-1.5 text-sm text-ink-800 dark:text-ink-200">{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="py-12">
    <div class="border border-ink-200 dark:border-ink-800">
      <div class="flex items-center justify-between border-b border-ink-200 px-4 py-3 dark:border-ink-800">
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-400 dark:text-ink-500">
          Live report
        </span>
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      </div>
      <iframe
        title="mobuzu-pbi"
        width="100%"
        height="640"
        src="https://app.powerbi.com/view?r=eyJrIjoiZWI1YzJjMTktNWQzNy00NzlhLTgxNTktYWMxY2RiMjI5ZDIzIiwidCI6ImM1ZDQwN2ZhLTNkZmItNDJjNy05MjYyLWRmODhkNWZlOTc1YSJ9"
        frameborder="0"
        allowfullscreen="true"
        class="block w-full">
      </iframe>
    </div>
  </section>
</BaseLayout>
