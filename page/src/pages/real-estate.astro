---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Real Estate Monitor"
  description="Visualize the trend in prices of apartments in the major cities in Colombia"
>
  <div class="max-w-7xl mx-auto">
    <div class="rounded-3xl border border-white/40 dark:border-white/10 bg-white/65 dark:bg-white/5 backdrop-blur-xl shadow-xl shadow-slate-900/5 p-6 md:p-8">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3 text-slate-900 dark:text-white">
        Real Estate Monitor
      </h1>

      <p class="text-base md:text-lg text-slate-600 dark:text-slate-300 mb-6">
        In this dashboard users can visualize the trend in prices of apartments in the major cities in Colombia 🇨🇴
      </p>

      <div class="rounded-2xl border border-white/40 dark:border-white/10 bg-white/40 dark:bg-black/20 backdrop-blur-md p-2 md:p-3 overflow-hidden">
        <iframe
          title="mobuzu-pbi"
          width="100%"
          height="600"
          src="https://app.powerbi.com/view?r=eyJrIjoiZWI1YzJjMTktNWQzNy00NzlhLTgxNTktYWMxY2RiMjI5ZDIzIiwidCI6ImM1ZDQwN2ZhLTNkZmItNDJjNy05MjYyLWRmODhkNWZlOTc1YSJ9"
          frameborder="0"
          allowfullscreen="true"
          class="rounded-xl block w-full">
        </iframe>
      </div>
    </div>
  </div>
</BaseLayout>
